// Windows resources for ingle.exe: the icon Explorer, shortcuts and the taskbar show, and the
// details in the file's Properties (and Task Manager). Built by build.rs on Windows targets.
1 ICON "assets/icon/ingle.ico"

1 VERSIONINFO
FILEVERSION 0,6,1,0
PRODUCTVERSION 0,6,1,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Firelit Games"
      VALUE "FileDescription", "Ingle"
      VALUE "FileVersion", "0.6.1"
      VALUE "InternalName", "ingle"
      VALUE "OriginalFilename", "ingle.exe"
      VALUE "ProductName", "Ingle"
      VALUE "ProductVersion", "0.6.1"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
