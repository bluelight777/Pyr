#!/bin/sh
set -e
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
fi
if [ "$1" = purge ]; then
    # Only a purge deletes the service's data (its chat history and TLS key).
    rm -rf /var/lib/ingle-server
    if getent passwd ingle-server >/dev/null; then
        if command -v deluser >/dev/null 2>&1; then
            deluser --system --quiet ingle-server || true
        else
            userdel ingle-server || true
        fi
    fi
fi
exit 0
