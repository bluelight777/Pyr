# Host a Pyr community as a background service (not enabled by default):
#   sudo nano /etc/default/pyr-server        # set --public-host
#   sudo systemctl enable --now pyr-server
#   sudo journalctl -u pyr-server            # shows your owner link the first time
[Unit]
Description=Pyr community server
Documentation=file:///usr/share/doc/pyr/README.md
After=network-online.target
Wants=network-online.target

[Service]
User=pyr-server
Group=pyr-server
EnvironmentFile=-/etc/default/pyr-server
ExecStart=/usr/bin/pyr-server --data /var/lib/pyr-server $PYR_SERVER_ARGS
Restart=on-failure
RestartSec=5
StateDirectory=pyr-server
StateDirectoryMode=0750
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
UMask=0077
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
